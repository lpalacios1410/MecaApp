# Configuración mínima por instancia (un solo archivo .env)
# 1. Proyecto Supabase propio por cliente/empresa
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# 2. Secreto del servidor (NUNCA usar prefijo NEXT_PUBLIC ni exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# 3. Correo global/propietario: único admin por configuración.
#    Este correo se promueve a admin al registrarse y puede promover
#    a otros usuarios como administradores o mecánicos desde el panel.
OWNER_EMAIL=dueno@tallercliente.com

# Opcional: origen para los correos de confirmación de Supabase.
# En Vercel se deriva automáticamente de VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=https://cliente.mecaapp.com
